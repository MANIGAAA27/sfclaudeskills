# Yahoo Mail MCP connector — copy to .env and fill in, or export these in your shell.
# .env is gitignored. Never commit a real app password.

# Required: the Yahoo address to connect.
YAHOO_EMAIL=you@yahoo.com

# Required: a Yahoo APP PASSWORD, not your account password.
# Generate at https://login.yahoo.com/account/security -> "Generate app password".
YAHOO_APP_PASSWORD=

# Optional: display name used in the From header.
YAHOO_FROM_NAME=

# Optional: register only the read tools (no send, move, flag or trash).
# YAHOO_MCP_READ_ONLY=1

# Optional: truncate each message body part to this many characters (default 20000).
# YAHOO_MCP_MAX_BODY_CHARS=20000

# Optional: where yahoo_save_attachment writes files (default ./yahoo-attachments).
# YAHOO_MCP_DOWNLOAD_DIR=yahoo-attachments

# Optional: server overrides. Defaults are Yahoo's documented endpoints.
# YAHOO_IMAP_HOST=imap.mail.yahoo.com
# YAHOO_IMAP_PORT=993
# YAHOO_SMTP_HOST=smtp.mail.yahoo.com
# YAHOO_SMTP_PORT=465
