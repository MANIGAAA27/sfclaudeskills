  "description": "MCP server that connects Claude Code to a Yahoo Mail mailbox over IMAP and SMTP using a Yahoo app password.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "yahoo-mail-mcp": "src/index.js"
  },
  "main": "src/index.js",
